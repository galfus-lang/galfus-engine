{
  "name": "galfus-monorepo",
  "version": "0.0.0",
  "description": "Galfus Engine monorepo",
  "author": "Renato Rodrigues (morbden) <renato@vulppi.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/galfus-lang/galfus-engine.git"
  },
  "bugs": {
    "url": "https://github.com/galfus-lang/galfus-engine/issues"
  },
  "homepage": "https://github.com/galfus-lang/galfus-engine#readme",
  "keywords": [
    "galfus",
    "game-engine",
    "rust",
    "typescript",
    "webgpu",
    "ecs",
    "multiverse"
  ],
  "type": "module",
  "workspaces": [
    "host/*"
  ],
  "scripts": {
    "prepare": "bun scripts/prepare.ts",
    "format": "bun scripts/format.ts",
    "format:check": "bun scripts/format.ts --check",
    "check": "bun scripts/check.ts",
    "validate": "bun run format:check && bun check",
    "version": "bun scripts/github/set-version.ts",
    "codegen": "bun scripts/codegen.ts",
    "build:cli": "bun --filter @galfus/engine build:cli",
    "build:napi": "cargo build -p galfus-native --features napi && cp build/cargo-target/debug/libgalfus_native.so build/cargo-target/debug/galfus.node && cargo build -p galfus-native",
    "test:ffi": "bun scripts/test-ffi.ts",
    "test:binds": "bun scripts/test-binds.ts",
    "test:napi": "bun run build:napi && bun scripts/test-napi.ts",
    "test:browser": "bun scripts/test-browser.ts",
    "test:tour:browser": "bun scripts/test-browser-tour.ts",
    "test:host": "bun test host",
    "demo": "bun scripts/host-sync.ts --skip-wasm && bun host/demos/src/main.ts",
    "host:sync": "bun scripts/host-sync.ts",
    "host:demo": "bun host/demos/src/main.ts",
    "gltf": "bun scripts/gltf-viewer.ts",
    "tour": "bun examples/feature-tour/runners/bun/index.ts",
    "tour:bun": "bun examples/feature-tour/runners/bun/index.ts",
    "tour:node": "bun examples/feature-tour/runners/node/index.ts",
    "tour:python": "python3 examples/feature-tour/runners/python/main.py",
    "tour:lua": "luajit examples/feature-tour/runners/lua/main.lua",
    "tour:c": "make -C examples/feature-tour/runners/c run",
    "tour:csharp": "dotnet run --project examples/feature-tour/runners/csharp/FeatureTour.csproj",
    "tour:browser": "bun examples/feature-tour/runners/browser/index.ts"
  },
  "devDependencies": {
    "@galfus/demos": "workspace:*",
    "@galfus/engine": "workspace:*",
    "@galfus/gltf-loader": "workspace:*",
    "@galfus/model-loader-types": "workspace:*",
    "@galfus/transport-browser": "workspace:*",
    "@galfus/transport-bun": "workspace:*",
    "@galfus/transport-node": "workspace:*",
    "@galfus/transport-types": "workspace:*",
    "@galfus/ui": "workspace:*",
    "@johnnymorganz/stylua-bin": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
