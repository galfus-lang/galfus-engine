{
  "name": "galfus-monorepo",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "bun scripts/format.ts",
    "check": "bun scripts/check.ts",
    "codegen": "bun scripts/codegen.ts",
    "test:ffi": "bun scripts/test-ffi.ts",
    "test:napi": "cargo build -p galfus-native --features napi && bun scripts/test-napi.ts",
    "demo": "cargo build -p galfus-native && bun scripts/demos/main.ts",
    "demo:0": "cargo build -p galfus-native && bun scripts/demos/main.ts 0",
    "demo:1": "cargo build -p galfus-native && bun scripts/demos/main.ts 1",
    "demo:2": "cargo build -p galfus-native && bun scripts/demos/main.ts 2",
    "demo:3": "cargo build -p galfus-native && bun scripts/demos/main.ts 3",
    "typecheck": "bun --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prettier": "^3.9.10"
  }
}
