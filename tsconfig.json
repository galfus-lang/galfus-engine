{
  "include": [
    "host/**/*.ts",
    "host/**/*.tsx",
    "sdk/**/*.ts",
    "sdk/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@galfus/transport-types": ["./host/transport-types/src/index.ts"],
      "@galfus/transport-bun": ["./host/transport-bun/src/index.ts"],
      "@galfus/transport-node": ["./host/transport-node/src/index.ts"],
      "@galfus/transport-browser": ["./host/transport-browser/src/index.ts"],
      "@galfus/engine": ["./host/engine/src/index.ts"],
      "@galfus/engine/math": ["./host/engine/src/math/index.ts"],
      "@galfus/engine/ecs": ["./host/engine/src/ecs/index.ts"],
      "@galfus/engine/anchors": ["./host/engine/src/anchors/index.ts"],
      "@galfus/engine/multiverse": ["./host/engine/src/multiverse/index.ts"],
      "@galfus/engine/realm2d": ["./host/engine/src/realm2d/index.ts"],
      "@galfus/engine/realm2d/utils": ["./host/engine/src/realm2d/utils/index.ts"],
      "@galfus/engine/realm2d/presets": ["./host/engine/src/realm2d/presets/index.ts"],
      "@galfus/engine/realm3d": ["./host/engine/src/realm3d/index.ts"],
      "@galfus/engine/realm3d/utils": ["./host/engine/src/realm3d/utils/index.ts"],
      "@galfus/engine/realm3d/presets": ["./host/engine/src/realm3d/presets/index.ts"],
      "@galfus/engine/resources": ["./host/engine/src/resources/index.ts"],
      "@galfus/engine/audio": ["./host/engine/src/audio/index.ts"],
      "@galfus/engine/animation": ["./host/engine/src/animation/index.ts"],
      "@galfus/engine/platform": ["./host/engine/src/platform/index.ts"],
      "@galfus/engine/types": ["./host/engine/src/types.ts"]
    },
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
