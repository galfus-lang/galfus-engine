{
  "name": "@galfus/engine",
  "version": "0.0.0",
  "description": "Lightweight, high-performance TypeScript ECS and multiverse game engine built for Galfus",
  "author": "Renato Rodrigues (morbden) <renato@vulppi.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/galfus-lang/galfus-engine.git",
    "directory": "host/engine"
  },
  "bugs": {
    "url": "https://github.com/galfus-lang/galfus-engine/issues"
  },
  "homepage": "https://github.com/galfus-lang/galfus-engine#readme",
  "keywords": [
    "galfus",
    "game-engine",
    "ecs",
    "2d",
    "3d",
    "multiverse",
    "webgpu",
    "scene-graph",
    "audio",
    "animation",
    "spatial",
    "raycast",
    "input"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "galfus-engine": "./bin/galfus-engine.js"
  },
  "scripts": {
    "build:cli": "bun scripts/bundle-cli.ts",
    "prepack": "bun run build:cli"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./math": "./src/math/index.ts",
    "./ecs": "./src/ecs/index.ts",
    "./anchors": "./src/anchors/index.ts",
    "./multiverse": "./src/multiverse/index.ts",
    "./realm2d": "./src/realm2d/index.ts",
    "./realm2d/utils": "./src/realm2d/utils/index.ts",
    "./realm2d/presets": "./src/realm2d/presets/index.ts",
    "./realm3d": "./src/realm3d/index.ts",
    "./realm3d/utils": "./src/realm3d/utils/index.ts",
    "./realm3d/presets": "./src/realm3d/presets/index.ts",
    "./resources": "./src/resources/index.ts",
    "./audio": "./src/audio/index.ts",
    "./animation": "./src/animation/index.ts",
    "./platform": "./src/platform/index.ts",
    "./types": "./src/types.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@galfus/transport-types": "workspace:*",
    "commander": "^15.0.0",
    "iconv-lite": "^0.7.3"
  }
}
